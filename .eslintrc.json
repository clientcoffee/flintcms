{
  "extends": "standard",
  "env": {
    "browser": true,
    "es2021": true
  },
  "globals": {
    "CSRF_TOKEN": "readonly"
  },
  "rules": {
    "semi": ["error", "always"],
    "indent": ["error", 2],
    "quotes": ["error", "double", { "allowTemplateLiterals": true }],
    "no-console": "warn",
    "no-unused-vars": "error"
  }
}
